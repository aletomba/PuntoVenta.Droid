{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5433;Database=puntoventa;Username=postgres;Password=postgres"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "PuntoVenta.Api",
    "Audience": "PuntoVenta.App",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Lockout": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "AllowedHosts": "*"
}
